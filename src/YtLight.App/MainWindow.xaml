<Window x:Class="YtLight.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:YtLight.App.Views"
        xmlns:vm="clr-namespace:YtLight.App.ViewModels"
        xmlns:models="clr-namespace:YtLight.Core.Models;assembly=YtLight.Core"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="YtLight"
        Width="1100" Height="720"
        MinWidth="880" MinHeight="560"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Invisible WebView2 audio engine host -->
        <wv2:WebView2 x:Name="PlayerWebView" Width="1" Height="1" IsHitTestVisible="False"
                      HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="YtLight" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Margin="16,0" VerticalAlignment="Center"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnSearchKeyDown"/>
                <ComboBox Grid.Column="2" Width="240" Margin="8,0"
                          ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding ActiveProfile}"
                          Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:YoutubeProfile}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Handle, StringFormat=' ({0})'}" Foreground="{StaticResource MutedBrush}" Margin="4,0,0,0" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButton}" Content="Giriş yap" Click="OnSignIn"
                            Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisInvert}}"/>
                    <Button Style="{StaticResource GhostButton}" Content="Çıkış" Command="{Binding SignOutCommand}"
                            Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <TabControl SelectedIndex="{Binding SelectedTab}" SelectionChanged="OnTabChanged">
                <TabItem Header="Kütüphanem ve Çalma Listeleri">
                    <views:LibraryView DataContext="{Binding Library}"/>
                </TabItem>
                <TabItem Header="Keşfet">
                    <views:ExploreView DataContext="{Binding Explore}"/>
                </TabItem>
            </TabControl>

            <Border Background="#E0121212" Visibility="{Binding IsSearchOpen, Converter={StaticResource BoolToVis}}" MouseDown="OnCloseSearch">
                <Border Background="{StaticResource SurfaceBrush}" Width="640" MaxHeight="420" VerticalAlignment="Top" Margin="0,8"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Arama sonuçları" FontWeight="SemiBold" Margin="4"/>
                        <ListBox ItemsSource="{Binding SearchSongs}" MouseDoubleClick="OnSearchDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Track}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" Foreground="{StaticResource MutedBrush}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"/>
                                            <TextBlock Text="{Binding Artists}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Seçili listeye ekle" Click="OnSearchAdd"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Border>

            <Border Width="320" HorizontalAlignment="Right" Background="{StaticResource SurfaceBrush}"
                    Visibility="{Binding Player.IsQueueOpen, Converter={StaticResource BoolToVis}}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Çalma sırası" FontWeight="SemiBold" Margin="12,10"/>
                    <ListBox x:Name="QueueList" ItemsSource="{Binding Player.Queue}"
                             AllowDrop="True"
                             PreviewMouseMove="QueuePreviewMouseMove"
                             Drop="QueueDrop"
                             DragOver="QueueDragOver">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Track.Title, Mode=OneWay}"/>
                                    <Run Text=" — " Foreground="{StaticResource MutedBrush}"/>
                                    <Run Text="{Binding Track.Artists, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <views:PlayerBar Grid.Row="2" DataContext="{Binding Player}"/>
    </Grid>
</Window>
