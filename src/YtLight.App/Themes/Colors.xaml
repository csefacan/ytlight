<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#FF121212</Color>
    <Color x:Key="SurfaceColor">#FF1C1C1C</Color>
    <Color x:Key="SurfaceAltColor">#FF242424</Color>
    <Color x:Key="BorderColor">#FF2E2E2E</Color>
    <Color x:Key="TextColor">#FFEEEEEE</Color>
    <Color x:Key="MutedColor">#FF9A9A9A</Color>
    <Color x:Key="AccentColor">#FFE11D48</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
</ResourceDictionary>
