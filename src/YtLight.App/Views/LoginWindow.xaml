<Window x:Class="YtLight.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="YouTube Music — Giriş"
        Width="920" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="#121212">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1C1C1C" Padding="14,10" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1">
            <TextBlock x:Name="StatusText" Foreground="#E0E0E0" FontSize="13"
                       Text="Lütfen Google hesabınızla giriş yapın. Giriş tamamlanıp YouTube Music açıldığında bu pencere otomatik kapanacaktır."/>
        </Border>
        <wv2:WebView2 x:Name="Browser"/>
    </DockPanel>
</Window>
