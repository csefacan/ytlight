<Application x:Class="YtLight.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:YtLight.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisInvert" Invert="True"/>
            <conv:PlayLabelConverter x:Key="PlayLabelConverter"/>
            <conv:MuteLabelConverter x:Key="MuteLabelConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
